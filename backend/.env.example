DJANGO_SECRET_KEY=django-insecure-dev-secret-key-replace-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=soliofit
POSTGRES_USER=soliofit
POSTGRES_PASSWORD=localdev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
FRONTEND_URL=http://localhost:3000

# Public origin the password-reset link points at (the frontend).
FRONTEND_BASE_URL=http://localhost:3000

# Email — dev defaults to the console backend (mail prints to logs, nothing sent).
# For real delivery (Gmail SMTP), set EMAIL_BACKEND to the SMTP backend and fill
# EMAIL_HOST_USER / EMAIL_HOST_PASSWORD (Gmail App Password, not the account password).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Soliofit <noreply@soliofit.app>
# Password-reset token validity in seconds (default 3 days).
PASSWORD_RESET_TIMEOUT=259200

# ── Production (VS-18 / ADR-0008) ─────────────────────────────────────────────
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# POSTGRES_HOST=postgres            # the compose service name in production
# REDIS_URL=redis://redis:6379/0
# S3 media uploads (set S3_BUCKET_NAME to enable real S3 instead of local stub)
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=your-s3-media-bucket
# BACKUP_BUCKET=your-s3-backup-bucket
